    "Tap a move with the play icon in the move list to see its details and watch how it works.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a move with the play icon in the move list to see its details and watch how it works."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기술 목록에서 재생 아이콘이 있는 기술을 눌러보세요. 상세 정보와 영상으로 어떤 기술인지 확인할 수 있어요."
          }
        }
      }
    },
